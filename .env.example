# ntfy source-health alerts. Choose any topic name you control.
NTFY_SERVER=https://ntfy.majmohar.eu
NTFY_TOPIC=isrm-alerts

# Optional, only if your ntfy server requires an access token.
NTFY_TOKEN=

# Optional release label shown in deployment and shutdown notifications.
APP_VERSION=1.6
ANDROID_APP_VERSION=1.0
# Direct HTTPS link to the signed, versioned APK asset. Set after publishing a GitHub release.
ANDROID_APK_URL=
# Stable page opened by the Android app before a download. Defaults to /android when blank.
ANDROID_RELEASE_URL=https://isrm.majmohar.eu/android

# Required to enable the persistent custom-event editor in Settings.
ADMIN_PASSWORD=

# The app preloads and retains eight upcoming weeks (about two months).
PRELOAD_WEEKS=8

# Localhost port exposed by Docker. Your separate proxy should target this port.
HOST_PORT=3000
