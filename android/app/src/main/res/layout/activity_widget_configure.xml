<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/canvas" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="28dp" android:paddingEnd="20dp" android:paddingBottom="32dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" android:text="IŠRM · PRIPOMOČEK" android:textColor="@color/muted" android:textSize="10sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="sans-serif" android:letterSpacing="-0.025" android:text="Izberi prikaz" android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.2" android:text="Pripomoček pokaže tisto, kar potrebuješ, še preden odpreš urnik." android:textColor="@color/muted" android:textSize="14sp" />

        <LinearLayout android:id="@+id/next_option" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Naslednja ura" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Velik čas, predmet in prostor. Najboljše za hiter pogled pred odhodom." android:textColor="@color/muted" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/widget_preview_background" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" android:text="NASLEDNJA URA · IŠRM" android:textColor="#B8C7BC" android:textSize="9sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:fontFamily="monospace" android:text="08:00" android:textColor="#F2F5F0" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Linearna algebra" android:textColor="#F2F5F0" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="P.02 · FRI" android:textColor="#B8C7BC" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/day_option" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Današnji pregled" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Do tri današnje obveznosti. Izberi ga, kadar želiš cel dan videti na začetnem zaslonu." android:textColor="@color/muted" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/widget_preview_background" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" android:text="DANES · IŠRM" android:textColor="#B8C7BC" android:textSize="9sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/widget_preview_line" android:padding="7dp" android:text="08:00  Linearna algebra · P.02" android:textColor="#EFF4EE" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/widget_preview_line" android:padding="7dp" android:text="10:15  Analiza · A.01" android:textColor="#EFF4EE" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="2 obveznosti danes" android:textColor="#A8BAB0" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:text="LETNIK" android:textColor="@color/muted" android:textSize="10sp" />
        <Spinner android:id="@+id/year" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/input_surface" android:entries="@array/programme_years" android:paddingStart="14dp" android:paddingEnd="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:text="VPISNA ŠTEVILKA · NEOBVEZNO" android:textColor="@color/muted" android:textSize="10sp" />
        <EditText android:id="@+id/student" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/input_surface" android:hint="Za osebne skupine vaj" android:inputType="number" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="15sp" />
        <TextView android:id="@+id/save" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="28dp" android:background="@drawable/today_button" android:gravity="center" android:text="Dodaj pripomoček" android:textColor="@color/on_accent" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
