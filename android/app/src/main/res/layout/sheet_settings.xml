<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/canvas"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">
    <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="24dp" android:background="@drawable/sheet_handle" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" android:text="NASTAVITVE URNIKA" android:textColor="@color/muted" android:textSize="10sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:fontFamily="sans-serif" android:text="Prikaži svoj urnik" android:textColor="@color/ink" android:textSize="25sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:text="LETNIK" android:textColor="@color/muted" android:textSize="10sp" />
    <Spinner android:id="@+id/settings_year" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/input_surface" android:paddingStart="14dp" android:paddingEnd="12dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:text="VPISNA ŠTEVILKA · NEOBVEZNO" android:textColor="@color/muted" android:textSize="10sp" />
    <EditText android:id="@+id/settings_student" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/input_surface" android:hint="Za osebne skupine vaj" android:inputType="number" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="15sp" />
    <TextView android:id="@+id/settings_save" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="28dp" android:background="@drawable/today_button" android:gravity="center" android:text="Shrani spremembe" android:textColor="@color/on_accent" android:textSize="15sp" android:textStyle="bold" />
</LinearLayout>
